# HDLA OneFirm — environment variables
# Copy the VALUES from the current Hub's Vercel project; nothing is hardcoded in this codebase.
# Every variable below is required unless marked optional.

# ── Supabase (same project as the current Hub — same data, same logins) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Access codes (one per tier) ──
PIN_PARTNER=
PIN_PRINCIPAL=
PIN_STAFF=

# ── Microsoft Graph: SharePoint (Master Data, backups) and Outlook calendar ──
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_HOST=hodgsondouglas.sharepoint.com
SHAREPOINT_SITE=Sharepoint
SHAREPOINT_FOLDER=HDLA Dashboard

# ── Anthropic (Proposal Agent) ──
ANTHROPIC_API_KEY=

# ── QuickBooks Online ──
# Development (sandbox) keys from developer.intuit.com → Keys & Credentials; swap for Production keys once Intuit approves.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# 'sandbox' or 'production' — decides which Intuit API host is used
QBO_ENV=sandbox
# Must match a Redirect URI registered on the Intuit app, e.g. https://onefirm.hodgsondouglas.com/api/quickbooks/callback
QBO_REDIRECT_URI=
# 32+ random characters; encrypts the stored QuickBooks tokens at rest (openssl rand -hex 32)
QBO_TOKEN_SECRET=

# ── Vercel cron (nightly QuickBooks sync + backup). Any long random string; Vercel sends it as a Bearer token. ──
CRON_SECRET=

# ── Optional ──
# Public hostname, used for absolute links in emails/PDFs (defaults to the request origin)
NEXT_PUBLIC_SITE_URL=
